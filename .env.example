# Copy this file to .env and fill in your credentials
# Do NOT commit .env to version control

# WRDS Credentials (required for data pulls)
# Replace with YOUR WRDS username - do not use someone else's
WRDS_USERNAME=

# Optional: Override default paths
# DATA_DIR=_data
# OUTPUT_DIR=_output

# Optional: Override default date range (format: YYYY-MM-DD)
# START_DATE=1930-01-01
# END_DATE=2024-12-31
